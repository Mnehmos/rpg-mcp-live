# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=data/rpg-mcp-live.db

# Clerk: copy from the development instance API keys page.
# The publishable key may be sent to the browser; the secret key is backend-only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Explicit local-only bypass. Keep false when deploying to Railway.
DEV_AUTH_BYPASS=true
DEV_USER_ID=local-player

# Stripe test-mode configuration.
# STRIPE_PRICE_ID is the recurring Price for the player subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SUBSCRIPTION_LABEL=Player Pass
SUBSCRIPTION_PRICE_LABEL=$5 / month

# Lantern engine. Run the engine separately on port 3100 during local development.
ENGINE_PORT=3100
ENGINE_URL=http://localhost:3100
ENGINE_SHARED_SECRET=lantern-dev-engine-secret
ENGINE_TIMEOUT_MS=30000

# Reference engine (the only runtime backend). Required — the web service
# refuses to start without the URL and token.
REFERENCE_ENGINE_URL=http://localhost:3100/mcp
REFERENCE_ENGINE_TOKEN=
REFERENCE_ENGINE_TIMEOUT_MS=30000
# Signs the per-call tenant context (x-rpg-tenant) that tells the engine which
# customer a request is for. Must hold the same value as the engine's
# RPG_MCP_TENANT_SECRET, and a DIFFERENT value per environment — a shared
# staging/production secret would let a staging compromise mint production
# tenant contexts. When unset, no tenant header is sent and the engine will
# refuse any tool that touches campaign state.
REFERENCE_ENGINE_TENANT_SECRET=

# OpenRouter belongs on the server-side web DM host, not in the reference rules
# engine, browser, or web page. Never expose the API key in public/.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# The fallback model is used for the single retry when the primary produces no
# first delta, or when the primary is rate-limited upstream (HTTP 429).
# Retrying a saturated model against itself rarely helps, so leaving this empty
# means a rate-limited turn simply fails. Set it to a model on a different
# upstream provider for it to be worth anything.
OPENROUTER_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_FIRST_TOKEN_TIMEOUT_MS=8000
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_MAX_TOKENS=2500
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Quest Keeper AI

# Provider admission gate. Concurrent turns are held to a bounded number of
# simultaneous upstream calls; the rest queue. A shared provider pool answers a
# burst with 429s, so a short queue beats a wide fan-out. A turn never waits
# past its own deadline, and a refused turn is cleanly not-committed.
PROVIDER_MAX_CONCURRENT=4
# One resolving turn per account. Also stops a player with several open tabs
# from occupying the whole pool.
PROVIDER_MAX_CONCURRENT_PER_ACCOUNT=1
PROVIDER_MAX_QUEUE_WAIT_MS=15000

# Abuse controls, separate from the dollar ledger: the cost gate cannot see a
# burst, a signup farm, or an account whose payment was clawed back.
ABUSE_TURN_WINDOW_MS=60000
ABUSE_MAX_TURNS_PER_WINDOW=12
# Free accounts per signup origin (IPv4 /24, IPv6 /48). Entitled accounts are
# never throttled by this: a card charge is a stronger signal than an address.
ABUSE_MAX_ACCOUNTS_PER_ORIGIN=4
ABUSE_ORIGIN_WINDOW_MS=86400000

# Dollar-only admission policy. Player Pass is monthly-only; raw token counts
# remain ledger telemetry and admitted commands finish before the next gate.
LLM_USAGE_PLAYER_MONTHLY_TARGET_COST_USD=2.00
LLM_USAGE_PLAYER_MONTHLY_COST_USD=4.00
LLM_USAGE_TURN_ADMISSION_RESERVE_COST_USD=0.01
LLM_USAGE_INPUT_COST_USD_PER_MILLION=0.0574
LLM_USAGE_OUTPUT_COST_USD_PER_MILLION=0.1148

# Engine-only persistence and internal authentication.
ENGINE_DATABASE_PATH=data/lantern-engine.db
ENGINE_INTERNAL_TOKEN=lantern-dev-engine-secret

# Pinned Open5e runtime policy. These filter the installed local pack; they do
# not enable runtime network access. Keep SRD-2014/CC-BY defaults for hosting.
CONTENT_GAMESYSTEM=5e-2014
CONTENT_ALLOWED_GAMESYSTEMS=5e-2014
CONTENT_DEFAULT_BASE_DOCUMENT=srd-2014
CONTENT_BASE_DOCUMENTS=srd-2014
CONTENT_ALLOWED_LICENSES=cc-by-40,cc0,ogl-10a
CONTENT_ALLOWED_DOCUMENTS=core,elderberry-inn-icons,open5e,srd-2014,tdcs,toh
