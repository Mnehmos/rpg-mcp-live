{"kind":"alignment","fidelityTier":1,"key":"srd-2014_chaotic-evil","contentKey":"open5e:alignment:5e-2014:srd-2014:chaotic-evil","sourceKey":"chaotic-evil","documentKey":"srd-2014","gamesystem":"5e-2014","publisher":{"key":"wizards-of-the-coast","name":"Wizards of the Coast"},"licenseKeys":["cc-by-40","ogl-10a"],"permalink":"https://dnd.wizards.com/resources/systems-reference-document","sourceApiVersion":"v2","sourceFetchedAt":"2026-08-07T00:00:00.000Z","name":"Chaotic-Evil","morality":"evil","societalAttitude":"chaotic","shortName":"CE","description":"Chaotic evil (CE) creatures act with arbitrary violence, spurred by their greed, hatred, or bloodlust. Demons, red dragons, and orcs are chaotic evil.","sourceContainerDocumentKey":"core"}
{"kind":"alignment","fidelityTier":1,"key":"srd-2014_chaotic-good","contentKey":"open5e:alignment:5e-2014:srd-2014:chaotic-good","sourceKey":"chaotic-good","documentKey":"srd-2014","gamesystem":"5e-2014","publisher":{"key":"wizards-of-the-coast","name":"Wizards of the Coast"},"licenseKeys":["cc-by-40","ogl-10a"],"permalink":"https://dnd.wizards.com/resources/systems-reference-document","sourceApiVersion":"v2","sourceFetchedAt":"2026-08-07T00:00:00.000Z","name":"Chaotic-Good","morality":"good","societalAttitude":"chaotic","shortName":"CG","description":"Chaotic good (CG) creatures act as their conscience directs, with little regard for what others expect.  Copper dragons, many elves, and unicorns are chaotic good.","sourceContainerDocumentKey":"core"}
{"kind":"alignment","fidelityTier":1,"key":"srd-2014_chaotic-neutral","contentKey":"open5e:alignment:5e-2014:srd-2014:chaotic-neutral","sourceKey":"chaotic-neutral","documentKey":"srd-2014","gamesystem":"5e-2014","publisher":{"key":"wizards-of-the-coast","name":"Wizards of the Coast"},"licenseKeys":["cc-by-40","ogl-10a"],"permalink":"https://dnd.wizards.com/resources/systems-reference-document","sourceApiVersion":"v2","sourceFetchedAt":"2026-08-07T00:00:00.000Z","name":"Chaotic-Neutral","morality":"neutral","societalAttitude":"chaotic","shortName":"CN","description":"Chaotic neutral (CN) creatures follow their whims, holding their personal freedom above all else. Many barbarians and rogues, and some bards, are chaotic neutral.","sourceContainerDocumentKey":"core"}
{"kind":"alignment","fidelityTier":1,"key":"srd-2014_lawful-evil","contentKey":"open5e:alignment:5e-2014:srd-2014:lawful-evil","sourceKey":"lawful-evil","documentKey":"srd-2014","gamesystem":"5e-2014","publisher":{"key":"wizards-of-the-coast","name":"Wizards of the Coast"},"licenseKeys":["cc-by-40","ogl-10a"],"permalink":"https://dnd.wizards.com/resources/systems-reference-document","sourceApiVersion":"v2","sourceFetchedAt":"2026-08-07T00:00:00.000Z","name":"Lawful-Evil","morality":"evil","societalAttitude":"lawful","shortName":"LE","description":"Lawful evil (LE) creatures methodically take what they want, within the limits of a code of tradition, loyalty, or order. Devils, blue dragons, and hobgoblins are lawful evil.","sourceContainerDocumentKey":"core"}
{"kind":"alignment","fidelityTier":1,"key":"srd-2014_lawful-good","contentKey":"open5e:alignment:5e-2014:srd-2014:lawful-good","sourceKey":"lawful-good","documentKey":"srd-2014","gamesystem":"5e-2014","publisher":{"key":"wizards-of-the-coast","name":"Wizards of the Coast"},"licenseKeys":["cc-by-40","ogl-10a"],"permalink":"https://dnd.wizards.com/resources/systems-reference-document","sourceApiVersion":"v2","sourceFetchedAt":"2026-08-07T00:00:00.000Z","name":"Lawful-Good","morality":"good","societalAttitude":"lawful","shortName":"LG","description":"Lawful good (LG) creatures can be counted on to do the right thing as expected by society. Gold dragons, paladins, and most dwarves are lawful good.","sourceContainerDocumentKey":"core"}
{"kind":"alignment","fidelityTier":1,"key":"srd-2014_lawful-neutral","contentKey":"open5e:alignment:5e-2014:srd-2014:lawful-neutral","sourceKey":"lawful-neutral","documentKey":"srd-2014","gamesystem":"5e-2014","publisher":{"key":"wizards-of-the-coast","name":"Wizards of the Coast"},"licenseKeys":["cc-by-40","ogl-10a"],"permalink":"https://dnd.wizards.com/resources/systems-reference-document","sourceApiVersion":"v2","sourceFetchedAt":"2026-08-07T00:00:00.000Z","name":"Lawful-Neutral","morality":"neutral","societalAttitude":"lawful","shortName":"LN","description":"Lawful neutral (LN) individuals act in accordance with law, tradition, or personal codes. Many monks and some wizards are lawful neutral.","sourceContainerDocumentKey":"core"}
{"kind":"alignment","fidelityTier":1,"key":"srd-2014_neutral","contentKey":"open5e:alignment:5e-2014:srd-2014:neutral","sourceKey":"neutral","documentKey":"srd-2014","gamesystem":"5e-2014","publisher":{"key":"wizards-of-the-coast","name":"Wizards of the Coast"},"licenseKeys":["cc-by-40","ogl-10a"],"permalink":"https://dnd.wizards.com/resources/systems-reference-document","sourceApiVersion":"v2","sourceFetchedAt":"2026-08-07T00:00:00.000Z","name":"Neutral","morality":"neutral","societalAttitude":"neutral","shortName":"N","description":"Neutral (N) is the alignment of those who prefer to steer clear of moral questions and don’t take sides, doing what seems best at the time. Lizardfolk, most druids, and many humans are neutral.","sourceContainerDocumentKey":"core"}
{"kind":"alignment","fidelityTier":1,"key":"srd-2014_neutral-evil","contentKey":"open5e:alignment:5e-2014:srd-2014:neutral-evil","sourceKey":"neutral-evil","documentKey":"srd-2014","gamesystem":"5e-2014","publisher":{"key":"wizards-of-the-coast","name":"Wizards of the Coast"},"licenseKeys":["cc-by-40","ogl-10a"],"permalink":"https://dnd.wizards.com/resources/systems-reference-document","sourceApiVersion":"v2","sourceFetchedAt":"2026-08-07T00:00:00.000Z","name":"Neutral-Evil","morality":"evil","societalAttitude":"neutral","shortName":"NE","description":"Neutral evil (NE) is the alignment of those who do whatever they can get away with, without compassion or qualms. Many drow, some cloud giants, and goblins are neutral evil.","sourceContainerDocumentKey":"core"}
{"kind":"alignment","fidelityTier":1,"key":"srd-2014_neutral-good","contentKey":"open5e:alignment:5e-2014:srd-2014:neutral-good","sourceKey":"neutral-good","documentKey":"srd-2014","gamesystem":"5e-2014","publisher":{"key":"wizards-of-the-coast","name":"Wizards of the Coast"},"licenseKeys":["cc-by-40","ogl-10a"],"permalink":"https://dnd.wizards.com/resources/systems-reference-document","sourceApiVersion":"v2","sourceFetchedAt":"2026-08-07T00:00:00.000Z","name":"Neutral-Good","morality":"good","societalAttitude":"neutral","shortName":"NG","description":"Neutral good (NG) folk do the best they can to help others according to their needs. Many celestials, some cloud giants, and most gnomes are neutral good.","sourceContainerDocumentKey":"core"}
